@{ Layout = null; }

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Link Manager</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --primary: #4361ee;
            --primary-dark: #3a56d4;
            --success: #2ec4b6;
            --danger: #e63946;
            --dark: #2b2d42;
            --light-bg: #f8f9fc;
            --card-shadow: 0 2px 12px rgba(0,0,0,0.08);
            --border-color: #e2e8f0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--light-bg);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .page-header {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
            padding: 20px 0;
            margin-bottom: 24px;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

            .page-header h4 {
                margin: 0;
                font-weight: 600;
                font-size: 20px;
            }

            .page-header p {
                margin: 4px 0 0;
                opacity: 0.85;
                font-size: 13px;
            }

        .card-custom {
            background: #fff;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .card-header-custom {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

            .card-header-custom h6 {
                margin: 0;
                font-weight: 600;
                color: var(--dark);
                font-size: 15px;
            }

        .table-modern {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .table-modern thead th {
                background: #f1f3f9;
                color: var(--dark);
                font-weight: 600;
                padding: 12px 14px;
                border-bottom: 2px solid var(--border-color);
                white-space: nowrap;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .table-modern tbody td {
                padding: 11px 14px;
                border-bottom: 1px solid #f0f0f0;
                vertical-align: middle;
            }

            .table-modern tbody tr:hover {
                background: #f8f9ff;
            }

            .table-modern tbody tr:last-child td {
                border-bottom: none;
            }

        .badge-status {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: capitalize;
        }

        .badge-success-custom {
            background: #d4edda;
            color: #155724;
        }

        .badge-pending {
            background: #fff3cd;
            color: #856404;
        }

        .badge-failed {
            background: #f8d7da;
            color: #721c24;
        }

        .badge-payu {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .badge-easebuzz {
            background: #e3f2fd;
            color: #1565c0;
        }

        .btn-copy {
            background: none;
            border: 1px solid var(--primary);
            color: var(--primary);
            padding: 3px 10px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-copy:hover {
                background: var(--primary);
                color: #fff;
            }

        /* ── Link Pending label in table ─────────────────────────────── */
        .link-pending {
            color: #999;
            font-size: 11px;
            font-style: italic;
        }

        .btn-create {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-create:hover {
                background: var(--primary-dark);
                color: #fff;
                box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
            }

        .modal-content {
            border-radius: 14px;
            border: none;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
        }

        .modal-header {
            border-bottom: 1px solid var(--border-color);
            padding: 16px 24px;
        }

            .modal-header .modal-title {
                font-weight: 600;
                font-size: 17px;
                color: var(--dark);
            }

        .modal-body {
            padding: 20px 24px;
        }

            .modal-body .form-group {
                margin-bottom: 14px;
            }

        .gateway-toggle {
            display: flex;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 18px;
        }

            .gateway-toggle label {
                flex: 1;
                text-align: center;
                padding: 10px 16px;
                margin: 0;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
                transition: all 0.25s;
                background: #fff;
                color: #666;
            }

                .gateway-toggle label i {
                    margin-right: 6px;
                }

            .gateway-toggle input[type="radio"] {
                display: none;
            }

                .gateway-toggle input[type="radio"]:checked + label {
                    background: var(--primary);
                    color: #fff;
                }

            .gateway-toggle .gw-divider {
                width: 2px;
                background: var(--border-color);
            }

        .form-label-sm {
            font-size: 12px;
            font-weight: 600;
            color: #555;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

            .form-label-sm .req {
                color: var(--danger);
            }

        .form-control {
            border-radius: 8px;
            border: 1px solid #d1d5db;
            padding: 8px 12px;
            font-size: 13px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.12);
            }

        select.form-control {
            appearance: auto;
        }

        /* ═══════════════════════════════════════════════════════════════════
           API FIELD-LEVEL ERROR STYLES
        ═══════════════════════════════════════════════════════════════════ */
        .api-error-banner {
            background: #fff5f5;
            border: 1px solid #fed7d7;
            border-left: 4px solid var(--danger);
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 16px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

            .api-error-banner i {
                color: var(--danger);
                margin-top: 2px;
                flex-shrink: 0;
            }

            .api-error-banner .error-text {
                font-size: 13px;
                color: #c53030;
                line-height: 1.5;
                white-space: pre-line;
            }

        .field-error-msg {
            color: var(--danger);
            font-size: 11px;
            margin-top: 3px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .field-error-msg i {
                font-size: 10px;
            }

        /* Highlight input border when API returns error for that field */
        .has-api-error {
            border-color: var(--danger) !important;
            box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.12) !important;
        }

        .easebuzz-section {
            background: #f0f4ff;
            border: 1px solid #d6e0ff;
            border-radius: 10px;
            padding: 14px 16px;
            margin-top: 4px;
            margin-bottom: 10px;
        }

            .easebuzz-section .section-title {
                font-size: 12px;
                font-weight: 700;
                color: var(--primary);
                margin-bottom: 12px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .submit-area {
            border-top: 1px solid var(--border-color);
            padding: 16px 0 0;
            margin-top: 8px;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

        .btn-submit {
            background: var(--success);
            color: #fff;
            border: none;
            padding: 9px 24px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-submit:hover:not(:disabled) {
                box-shadow: 0 4px 12px rgba(46, 196, 182, 0.35);
            }

            .btn-submit:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .btn-copy-link {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 9px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-copy-link:hover:not(:disabled) {
                box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
            }

            .btn-copy-link:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }

            .empty-state i {
                font-size: 40px;
                margin-bottom: 12px;
                color: #d0d0d0;
            }

            .empty-state p {
                margin: 0;
                font-size: 14px;
            }

        .table-responsive-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        @@media (max-width: 768px) {
            .page-header {
                padding: 16px 0;
            }

            .card-header-custom {
                padding: 12px 16px;
            }

            .modal-body {
                padding: 16px;
            }

            .gateway-toggle label {
                padding: 8px 10px;
                font-size: 12px;
            }

            .submit-area {
                justify-content: stretch;
            }

                .submit-area button {
                    flex: 1;
                }
        }
    </style>
</head>
<body>
    <div ng-app="PaymentLinkApp" ng-controller="PaymentLinkController">

        <div class="page-header">
            <div class="container">
                <h4><i class="fas fa-link"></i> &nbsp;Payment Link Manager</h4>
                <p>Create and manage payment links via Easebuzz</p>
            </div>
        </div>

        <div class="container" style="max-width:1100px;">
            <div class="card-custom">
                <div class="card-header-custom">
                    <h6><i class="fas fa-list-ul" style="color:var(--primary);margin-right:6px;"></i> Created Payment Links</h6>
                    <button class="btn-create" data-toggle="modal" data-target="#CreatePaymentLink" ng-click="resetForm()">
                        <i class="fas fa-plus"></i> &nbsp;Create Payment Link
                    </button>
                </div>
                <div class="table-responsive-wrapper">
                    <table class="table-modern" ng-if="CreatedPaymentLink.length > 0">
                        <thead>
                            <tr>
                                <th>Txn ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Mobile</th>
                                <th>Amount</th>
                                <th>Gateway</th>
                                <th>Status</th>
                                <th>Payment Link</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="c in CreatedPaymentLink">
                                <td style="font-weight:600;font-size:12px;">{{c.TXN_ID}}</td>
                                <td>{{c.customer_name}}</td>
                                <td>{{c.customer_email}}</td>
                                <td>{{c.customer_mobile}}</td>
                                <td style="font-weight:600;">&#8377;{{c.Indent_Amount}}</td>
                                <td>
                                    <span class="badge-status" ng-class="c.gateway === 'Easebuzz' ? 'badge-easebuzz' : (c.gateway === 'PayU' ? 'badge-payu' : 'badge-pending')">
                                        {{c.gateway}}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-status"
                                          ng-class="{'badge-success-custom': c.PaymentStatus==='success',
                                                     'badge-pending': c.PaymentStatus==='pend' || c.PaymentStatus==='initiated' || c.PaymentStatus==='active',
                                                     'badge-failed': c.PaymentStatus==='failure'}">
                                        {{c.PaymentStatus}}
                                    </span>
                                </td>
                                <td>
                                    <!-- ── Show Copy button ONLY if link exists ── -->
                                    <button class="btn-copy" ng-click="copyToClipboard(c.link)" ng-if="c.link">
                                        <i class="far fa-copy"></i> Copy
                                    </button>
                                    <!-- ── Show "Link Pending" if no link yet ── -->
                                    <span class="link-pending" ng-if="!c.link">
                                        <i class="fas fa-hourglass-half"></i> Link Pending
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="empty-state" ng-if="CreatedPaymentLink.length === 0">
                        <i class="fas fa-inbox"></i>
                        <p>No payment links created yet</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  Create Payment Link Modal                        -->
        <!-- ══════════════════════════════════════════════════ -->
        <form name="myForm">
            <div class="modal fade" id="CreatePaymentLink">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-plus-circle" style="color:var(--primary);margin-right:8px;"></i>Create New Payment Link</h5>
                            <button type="button" onclick="javascript:window.location.reload()" class="close" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body">

                            <!-- ═══════════════════════════════════════════════
                                 API ERROR BANNER — shows when Easebuzz returns errors
                            ════════════════════════════════════════════════ -->
                            <div class="api-error-banner" ng-if="apiErrorMessage">
                                <i class="fas fa-exclamation-circle"></i>
                                <div class="error-text">{{apiErrorMessage}}</div>
                            </div>

                            <!-- Customer Name -->
                            <div class="form-group">
                                <div class="form-label-sm"><span class="req">*</span> Customer Name</div>
                                <input name="customer_name" class="form-control" type="text" placeholder="Enter full name"
                                       ng-model="PaymentLinkObj.customer_name" required
                                       ng-class="{'has-api-error': fieldErrors.customer_name}"
                                       ng-change="clearFieldError('customer_name')">
                                <div class="field-error-msg" ng-if="fieldErrors.customer_name">
                                    <i class="fas fa-exclamation-circle"></i> {{fieldErrors.customer_name}}
                                </div>
                            </div>

                            <div class="row">
                                <!-- Mobile Number -->
                                <div class="col-md-6 form-group">
                                    <div class="form-label-sm"><span class="req">*</span> Mobile Number</div>
                                    <input name="customer_mobile" class="form-control" type="tel" placeholder="10-digit mobile"
                                           ng-pattern="/^[6-9][0-9]{9}$/" ng-model="PaymentLinkObj.customer_mobile"
                                           maxlength="10" ng-minlength="10" ng-maxlength="10" required
                                           onkeypress="return (event.charCode >= 48 && event.charCode <= 57)"
                                           ng-class="{'has-api-error': fieldErrors.customer_mobile}"
                                           ng-change="clearFieldError('customer_mobile')"
                                           style="{{myForm.customer_mobile.$touched && myForm.customer_mobile.$invalid && !fieldErrors.customer_mobile ? 'border-color:#e63946;' : ''}}">
                                    <!-- Angular validation errors -->
                                    <small style="color:#e63946;font-size:11px;"
                                           ng-show="myForm.customer_mobile.$touched && myForm.customer_mobile.$invalid && !fieldErrors.customer_mobile">
                                        <span ng-show="myForm.customer_mobile.$error.required">Mobile number is required</span>
                                        <span ng-show="myForm.customer_mobile.$error.minlength || myForm.customer_mobile.$error.maxlength">Must be exactly 10 digits</span>
                                        <span ng-show="myForm.customer_mobile.$error.pattern && !myForm.customer_mobile.$error.minlength">Must start with 6, 7, 8 or 9</span>
                                    </small>
                                    <!-- API validation error -->
                                    <div class="field-error-msg" ng-if="fieldErrors.customer_mobile">
                                        <i class="fas fa-exclamation-circle"></i> {{fieldErrors.customer_mobile}}
                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6 form-group">
                                    <div class="form-label-sm"><span class="req">*</span> Email</div>
                                    <input name="customer_email" class="form-control" type="email" placeholder="email@example.com"
                                           ng-model="PaymentLinkObj.customer_email" required
                                           ng-class="{'has-api-error': fieldErrors.customer_email}"
                                           ng-change="clearFieldError('customer_email')">
                                    <div class="field-error-msg" ng-if="fieldErrors.customer_email">
                                        <i class="fas fa-exclamation-circle"></i> {{fieldErrors.customer_email}}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- State -->
                                <div class="col-md-6 form-group">
                                    <div class="form-label-sm"><span class="req">*</span> State</div>
                                    <select name="state" class="form-control" ng-model="PaymentLinkObj.state"
                                            ng-options="s.state_name as s.state_name for s in StateList" required
                                            ng-class="{'has-api-error': fieldErrors.state}"
                                            ng-change="clearFieldError('state')">
                                        <option value="">Select State</option>
                                    </select>
                                    <div class="field-error-msg" ng-if="fieldErrors.state">
                                        <i class="fas fa-exclamation-circle"></i> {{fieldErrors.state}}
                                    </div>
                                </div>

                                <!-- City / Location -->
                                <div class="col-md-6 form-group">
                                    <div class="form-label-sm"><span class="req">*</span> City / Location</div>
                                    <input name="location" class="form-control" type="text" placeholder="Enter city"
                                           ng-model="PaymentLinkObj.location" required
                                           ng-class="{'has-api-error': fieldErrors.location}"
                                           ng-change="clearFieldError('location')">
                                    <div class="field-error-msg" ng-if="fieldErrors.location">
                                        <i class="fas fa-exclamation-circle"></i> {{fieldErrors.location}}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Amount -->
                                <div class="col-md-6 form-group">
                                    <div class="form-label-sm"><span class="req">*</span> Amount (&#8377;)</div>
                                    <input name="indent_amount" class="form-control" type="number" placeholder="0.00" min="1"
                                           ng-model="PaymentLinkObj.indent_amount" required
                                           ng-class="{'has-api-error': fieldErrors.indent_amount}"
                                           ng-change="clearFieldError('indent_amount')">
                                    <div class="field-error-msg" ng-if="fieldErrors.indent_amount">
                                        <i class="fas fa-exclamation-circle"></i> {{fieldErrors.indent_amount}}
                                    </div>
                                </div>

                                <!-- Nature of Payment -->
                                <div class="col-md-6 form-group">
                                    <div class="form-label-sm"><span class="req">*</span> Nature of Payment</div>
                                    <select name="paymentType" class="form-control" ng-model="PaymentLinkObj.paymentType"
                                            ng-options="p.lookup_code as p.lookup_name for p in PaymentNature" required
                                            ng-class="{'has-api-error': fieldErrors.paymentType}"
                                            ng-change="clearFieldError('paymentType')">
                                        <option value="">Select Type</option>
                                    </select>
                                    <div class="field-error-msg" ng-if="fieldErrors.paymentType">
                                        <i class="fas fa-exclamation-circle"></i> {{fieldErrors.paymentType}}
                                    </div>
                                </div>
                            </div>

                            <!-- Remarks -->
                            <div class="form-group">
                                <div class="form-label-sm">Remarks</div>
                                <input class="form-control" type="text" placeholder="Optional remarks"
                                       ng-model="PaymentLinkObj.remarks"
                                       ng-class="{'has-api-error': fieldErrors.remarks}"
                                       ng-change="clearFieldError('remarks')">
                                <div class="field-error-msg" ng-if="fieldErrors.remarks">
                                    <i class="fas fa-exclamation-circle"></i> {{fieldErrors.remarks}}
                                </div>
                            </div>

                            <!-- ── Easebuzz Settings (always visible) ─────── -->
                            <div class="easebuzz-section">
                                <div class="section-title"><i class="fas fa-bolt"></i> Easebuzz Settings</div>
                                <div class="row">
                                    <!-- Expiry Date -->
                                    <div class="col-md-6 form-group">
                                        <div class="form-label-sm"><span class="req">*</span> Expiry Date</div>
                                        <input class="form-control" type="text" placeholder="DD-MM-YYYY"
                                               ng-model="ebExpiryDate" required
                                               ng-class="{'has-api-error': fieldErrors.ebExpiryDate}"
                                               ng-change="clearFieldError('ebExpiryDate')">
                                        <div class="field-error-msg" ng-if="fieldErrors.ebExpiryDate">
                                            <i class="fas fa-exclamation-circle"></i> {{fieldErrors.ebExpiryDate}}
                                        </div>
                                    </div>

                                    <!-- Message -->
                                    <div class="col-md-6 form-group">
                                        <div class="form-label-sm"><span class="req">*</span> Message to Customer</div>
                                        <input class="form-control" type="text" placeholder="Payment link message"
                                               ng-model="ebMessage" required
                                               ng-class="{'has-api-error': fieldErrors.ebMessage}"
                                               ng-change="clearFieldError('ebMessage')">
                                        <div class="field-error-msg" ng-if="fieldErrors.ebMessage">
                                            <i class="fas fa-exclamation-circle"></i> {{fieldErrors.ebMessage}}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="submit-area">
                                <button type="button" class="btn-submit"
                                        ng-disabled="!myForm.$valid || isSubmitting"
                                        ng-click="submitPayment()">
                                    <span ng-if="!isSubmitting"><i class="fas fa-paper-plane"></i> &nbsp;Submit</span>
                                    <span ng-if="isSubmitting"><i class="fas fa-spinner fa-spin"></i> &nbsp;Processing...</span>
                                </button>
                                <button type="button" class="btn-copy-link"
                                        ng-disabled="disableCopy" ng-click="copyToClipboard(paymentLink)">
                                    <i class="far fa-copy"></i> &nbsp;Copy Link
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.6.9/angular.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="~/Scripts/Payment/PaymentLink.js?v=10"></script>
</body>
</html>
